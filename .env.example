# OpenAI API Key
OPENAI_API_KEY="your-openai-api-key"

# NH투자증권 PLUG Open API Key
NHPLUG_APP_KEY="your-nh-plug-app-key"
NHPLUG_APP_SECRET="your-nh-plug-app-secret"

# 모의투자 URL (테스트 단계에서는 모의투자 URL 필수 적용)
# 모의투자: https://moapi.nhplug.com:8443
# 실전투자: https://openapi.nhplug.com:8443
NHPLUG_BASE_URL="https://moapi.nhplug.com:8443"

# NH투자증권 중개형 ISA 계좌번호 (종합계좌번호 8자리 + 상품코드 2자리 = 총 10~11자리)
NH_ISA_ACCOUNT_NO="12345678-01"

# 단일 주문 금액 한도 (원 단위, 기본값: 3,000,000원)
ORDER_AMOUNT_LIMIT=3000000

# 브로커 API 주문 엔드포인트 ("standard": /krstock/order/v1/buy|sell, "cash": /krstock/order/v1/cashBuy|cashSell)
ORDER_API_ENDPOINT_STYLE="cash"

# Mock/Dry-run 모드 (True일 경우 실제 API 호출 대신 모의 실행 응답 반환)
DRY_RUN=false
